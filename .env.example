PORT=10000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_TEMP_BUCKET=processing-files

# File policy
FILE_LIMIT_MB=50
PROCESSED_FILE_TTL_MINUTES=3

# Pricing
SERVICE_PRICE_ETB=3
INTERNATIONAL_ACCESS_USD=1
INTERNATIONAL_ACCESS_DAYS=7
