PORT=10000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_TEMP_BUCKET=processing-files

# File policy
FILE_LIMIT_MB=50
PROCESSED_FILE_TTL_MINUTES=3

# Pricing
SERVICE_PRICE_ETB=3
INTERNATIONAL_ACCESS_USD=1
INTERNATIONAL_ACCESS_DAYS=7

# OCR
# Tesseract languages use + between language codes, e.g. eng+amh
OCR_LANGUAGES=eng+amh
OCR_DPI=200
OCR_MAX_PAGES=50

# ── Payment Providers ──────────────────────────────────────────────────────

# URLs
BACKEND_URL=https://your-backend.onrender.com
PAYMENT_RETURN_URL=https://your-site.com/payment/complete
PAYMENT_CANCEL_URL=https://your-site.com/payment/cancel

# Chapa (Local primary — user sees Telebirr/CBE/Dashen/Abyssinia)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# SantimPay (Local fallback)
SANTIMPAY_API_KEY=
SANTIMPAY_MERCHANT_ID=
SANTIMPAY_BASE_URL=https://api.santimpay.com/v1
SANTIMPAY_WEBHOOK_SECRET=

# Airtm (International)
AIRTM_API_KEY=
AIRTM_APP_ID=
AIRTM_BASE_URL=https://app.airtm.com/api/v1
AIRTM_WEBHOOK_SECRET=

# Paddle (International)
PADDLE_API_KEY=
PADDLE_PRICE_ID=
PADDLE_BASE_URL=https://api.paddle.com
PADDLE_WEBHOOK_SECRET=

# PayPal (International) — "sandbox" or "live"
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── Telegram Bot ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Optional: extra security header for webhook validation
TELEGRAM_WEBHOOK_SECRET=

# After deploying to Render, call:
# GET https://your-backend.onrender.com/bot/setup
# to register the webhook with Telegram automatically.
